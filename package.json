{
  "name": "musubi-cli",
  "version": "0.3.0",
  "description": "Binds the content one agent skill provides to the skills that follow it, and checks them again when that content changes",
  "keywords": [
    "agent-skills",
    "skills",
    "SKILL.md",
    "dependencies"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardene777/musubi.git"
  },
  "type": "module",
  "bin": {
    "musubi": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "spec",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --test-reporter=tap tests/*.test.ts",
    "prepack": "tsc -p tsconfig.build.json",
    "site": "node site/build.ts && node site/serve.ts",
    "site:build": "node site/build.ts",
    "site:publish": "node site/publish.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "typescript": "^5.9.2"
  }
}
